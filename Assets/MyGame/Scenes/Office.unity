  - {fileID: 1050015345}
  - {fileID: 308911378}
  trustBar: {fileID: 1833766481}
  questions:
  - questionText: What's your name?
    answers:
    - Detectiv Walker
    - Chris
    - I'm not telling you!
    - Uhmmm...
    correctAnswerIndex: 1
  - questionText: What are you doing here?
    answers:
    - I'm spying on you
    - I don't know
    - Not your business!
    - Trying to connect with like minded people
    correctAnswerIndex: 3
  - questionText: Who sent you?
    answers:
    - I got an invite
    - My boss
    - I...don't remember
    - The police
    correctAnswerIndex: 0
  - questionText: Do you like Tyran?
    answers:
    - Oh hell no!
    - Who's that?
    - I LOVE him. He'll save the country.
    - I'm not interested in politics.
    correctAnswerIndex: 2
  - questionText: Will you help us with the fake news spreading?
    answers:
    - That was you?
    - NO!
    - Yeah for sure!
    - The what?
    correctAnswerIndex: 2
  - questionText: Do you know who is responsible for spreading it?
    answers:
    - I don't care
    - What? Are you admitting this is organized?
    - No but I'd enjoy getting to know them!
    - I don't wanna know
    correctAnswerIndex: 0
  - questionText: I shouldn't be telling you so soon, but it's organized by Tyran
      himself.
    answers:
    - I'm gonna arrest him!
    - He should be exposed
    - That's amazing of him!
    - Is he crazy??
    correctAnswerIndex: 2
  - questionText: So are you all in?
    answers:
    - Nope
    - Maybe...
    - Yep!
    - I'll think about it
    correctAnswerIndex: 2
  currentQuestionIndex: 0
  next: {fileID: 0}
  person: {fileID: 0}
